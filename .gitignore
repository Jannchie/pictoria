# run_get_artist_data.py 的 tag 池（本地数据）
scripts/tags.txt
.env
__pycache__/
*.pyc
# run_get_artist_data.py 的 tag 冷却状态（本地运行痕迹）
scripts/.run_get_artist_data_state.json
scripts/.run_get_artist_data_state.jsonl

# Node —— 转成 pnpm workspace 后 node_modules 出现在仓库根，
# 而原来的 node_modules 规则只写在 web/.gitignore 里，管不到这一层。
node_modules/
dist/
*.log
# msys bash 崩溃转储：落进 apps/web/src 会让 Vite 的 watch EBUSY 退出
*.stackdump
*.tsbuildinfo
.vite/

# tag i18n 变更报告:每次 build 重新生成,给人看的,不是产物
server/data/tag.*.changes.tsv
