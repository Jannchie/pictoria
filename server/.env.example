# server/.env — local secrets. Copy to server/.env (git-ignored) and fill in.
#
# Who reads this file:
#   - the worker (`pnpm dev:worker`, python-dotenv, loaded at startup);
#   - apps/api reads only the S3_* keys below from it (src/s3.ts). It loads no
#     dotenv otherwise.
#
# Do NOT put DB_PATH / TASKS_DB_PATH / PICTORIA_TARGET_DIR here: the API would
# not see them, and the two processes would disagree about where the library is.
# Set them as real environment variables instead (both sides read them).

# Danbooru API credentials for the importers (worker/importers.py).
DANBOORU_API_KEY=
DANBOORU_USER_NAME=

# S3-compatible object storage: fallback for GET /v2/images/original/... when the
# local file is missing. All three of endpoint/access/secret are required to enable it.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional (defaults: pictoria / collections / derived from the endpoint host).
S3_BUCKET=
S3_BASE_DIR=
S3_REGION=
