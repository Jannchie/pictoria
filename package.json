{
  "name": "pictoria-monorepo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c cyan,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @pictoria/api dev",
    "dev:worker": "cd server && uv run ./src/worker/main.py --target_dir ./illustration/images",
    "dev:web": "pnpm --filter pictoria dev",
    "dev:api-quiet": "PICTORIA_SCHEDULER=0 pnpm --filter @pictoria/api dev",
    "ref:litestar": "cd server && PICTORIA_PORT=4779 PICTORIA_SKIP_WORKERS=basics,silva,silva_luna,waifu,tagger,embedding uv run ./src/app.py --target_dir ./illustration/images",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "genapi": "pnpm --filter pictoria genapi",
    "contract:diff": "node scripts/openapi-contract-diff.mjs docs/openapi.baseline.json http://127.0.0.1:4777/schema/openapi.json",
    "contract:test": "node scripts/openapi-contract-diff.test.mjs",
    "migration:status": "node scripts/migration-status.mjs",
    "parity": "node scripts/endpoint-parity.mjs",
    "parity:all": "pnpm parity && pnpm parity:write && pnpm parity:annotations && pnpm parity:tags && pnpm parity:timeline && pnpm parity:queues && pnpm parity:sampling && pnpm parity:commands && pnpm parity:images && pnpm parity:destructive && pnpm parity:s3 && pnpm contract:diff",
    "parity:annotations": "node scripts/annotations-parity.mjs",
    "parity:commands": "pnpm --filter @pictoria/api parity:commands",
    "parity:destructive": "pnpm --filter @pictoria/api parity:destructive",
    "parity:images": "node scripts/images-parity.mjs",
    "parity:queues": "node scripts/queues-parity.mjs",
    "parity:s3": "pnpm --filter @pictoria/api parity:s3",
    "parity:sampling": "node scripts/sampling-parity.mjs",
    "parity:tags": "node scripts/tag-writes-parity.mjs",
    "parity:timeline": "node scripts/timeline-parity.mjs",
    "parity:worker": "pnpm --filter @pictoria/api parity:worker",
    "parity:write": "node scripts/write-parity.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
